# Konfigurasi produksi Quis — salin ke .env.prod dan isi nilai rahasia.
# Dipakai oleh docker compose -f docker-compose.prod.yaml --env-file .env.prod.

# Domain publik (tanpa garis miring akhir). Socket.io diproxy lewat /socket.io
# di origin yang sama, jadi NEXT_PUBLIC_REALTIME_URL = PUBLIC_URL.
PUBLIC_URL=https://quis.airlangga.link

# Database — GANTI password!
POSTGRES_DB=quis
POSTGRES_USER=quis
POSTGRES_PASSWORD=ganti-password-panjang-acak

# Better Auth — generate: openssl rand -base64 32
BETTER_AUTH_SECRET=ganti-dengan-string-acak-32-karakter-min

# Secret bersama app ↔ realtime untuk JWT peserta/host (minimal 32 karakter).
# generate: openssl rand -base64 32
GAME_TOKEN_SECRET=ganti-dengan-string-acak-32-karakter-min

# Batas upload gambar (MB).
MAX_UPLOAD_MB=5
